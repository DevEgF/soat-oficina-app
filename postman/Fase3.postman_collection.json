{
  "info": {
    "name": "Oficina Fase 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Synthetic fixtures only. Tokens use run-local variables. Distinct owned orders must await approval/rejection. Set baseUrl to an actual API Gateway URL after deployment."
  },
  "item": [
    {
      "name": "Auth ACTIVE",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/token",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"cpf\": \"{{activeCpf}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const authResponse = pm.response.json();",
              "pm.test('15 minutes and no-store', () => { pm.expect(authResponse.expiresIn).to.eql(900); pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); });",
              "const claims = JSON.parse(require('buffer').Buffer.from(authResponse.accessToken.split('.')[1], 'base64').toString());",
              "pm.test('Customer JWT contract', () => { pm.expect(claims.iss).to.eql('oficina'); pm.expect([].concat(claims.aud)).to.include('oficina-api'); pm.expect(claims.env).to.eql(pm.environment.get('environment')); pm.expect(claims.scope).to.eql(['CUSTOMER']); pm.expect(claims.sub).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i); pm.expect(claims.exp-claims.iat).to.eql(900); pm.expect(claims).not.to.have.property('cpf'); });",
              "pm.variables.set('customerToken', authResponse.accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth invalid CPF",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/token",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"cpf\": \"invalid\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth BLOCKED",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/token",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"cpf\": \"{{blockedCpf}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.variables.set('blockedResponse', pm.response.text());"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth unknown",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/token",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"cpf\": \"{{unknownCpf}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('Same generic response', () => pm.expect(pm.response.text()).to.eql(pm.variables.get('blockedResponse')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Unauthenticated customer 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/customer/os/acompanhar?codigo={{trackingCode}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Staff login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/public/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{staffUsername}}\", \"password\": \"{{staffPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.variables.set('staffToken', pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "Staff reads fixture order",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/ordens-servico/{{workOrderId}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const order = pm.response.json(); pm.variables.set('workOrderId', order.id); pm.variables.set('trackingCode', order.trackingCode);"
            ]
          }
        }
      ]
    },
    {
      "name": "Staff cannot use customer scope",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/customer/os/acompanhar?codigo={{trackingCode}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer tracking",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/customer/os/acompanhar?codigo={{trackingCode}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Owned order', () => pm.expect(pm.response.json().trackingCode).to.eql(pm.variables.get('trackingCode')));"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer approval",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/customer/os/aprovar-orcamento?codigo={{approvalTrackingCode}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Approved', () => pm.expect(pm.response.json().status).to.eql('AWAITING_PARTS_RELEASE'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Customer rejection",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{customerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/customer/os/reprovar-orcamento?codigo={{rejectionTrackingCode}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Rejected', () => pm.expect(pm.response.json().status).to.eql('CANCELLED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Health and cleanup",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('UP', () => pm.expect(pm.response.json().status).to.eql('UP'));",
              "for (const key of ['customerToken','staffToken','blockedResponse']) { pm.variables.unset(key); }"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "staffToken",
      "value": ""
    },
    {
      "key": "trackingCode",
      "value": ""
    },
    {
      "key": "workOrderId",
      "value": ""
    },
    {
      "key": "approvalTrackingCode",
      "value": ""
    },
    {
      "key": "rejectionTrackingCode",
      "value": ""
    }
  ]
}
