[Unit]
Description=Publish Oficina aggregate business telemetry
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/oficina/business-telemetry.py
Environment=PATH=/usr/local/bin:/usr/bin
UMask=0077
TimeoutStartSec=90
CPUQuota=20%
MemoryMax=128M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadOnlyPaths=/etc/oficina
